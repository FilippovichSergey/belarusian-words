# Скапіруйце гэты файл у .env.local і запоўніце значэнні.
# Supabase: Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Падыходзіць як стары "anon public" ключ, так і новы "publishable" ключ (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Толькі для скрыптоў у scripts/ (не патрэбна для сайта):
# Supabase "service_role" ключ — ніколі не публікуйце яго і не дадавайце ў Vercel.
SUPABASE_SERVICE_ROLE_KEY=
# Ключ Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Мадэль для генерацыі малюнкаў (неабавязкова)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Мадэлі для разбору пастоў Telegram, па чарзе (неабавязкова).
# Бясплатны тарыф мае асобны дзённы ліміт на кожную мадэль.
# GEMINI_TEXT_MODELS=gemini-flash-latest,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-lite-latest
